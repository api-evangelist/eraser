{
  "opencollection": "1.0.0",
  "info": {
    "name": "Eraser AI Requests Folders API",
    "version": "v1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Folders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List folders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.eraser.io/api/folders",
            "params": [
              {
                "name": "parentFolderId",
                "value": "",
                "type": "query",
                "description": "Parent folder to list children of. Defaults to null (root folders)."
              },
              {
                "name": "recursive",
                "value": "",
                "type": "query",
                "description": "Include all descendant folders. Defaults to false."
              }
            ]
          },
          "docs": "Returns folders for the authenticated team. Optionally filter by parent folder or include all descendants recursively."
        },
        {
          "info": {
            "name": "Create a folder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.eraser.io/api/folders",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new folder for organizing Eraser files."
        },
        {
          "info": {
            "name": "Get a folder",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.eraser.io/api/folders/:folderId",
            "params": [
              {
                "name": "folderId",
                "value": "",
                "type": "path",
                "description": "Unique folder identifier"
              }
            ]
          },
          "docs": "Retrieves a specific folder by its ID."
        },
        {
          "info": {
            "name": "Update a folder",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.eraser.io/api/folders/:folderId",
            "params": [
              {
                "name": "folderId",
                "value": "",
                "type": "path",
                "description": "The folder identifier to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the name or parent folder of an existing folder."
        },
        {
          "info": {
            "name": "Delete a folder",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.eraser.io/api/folders/:folderId",
            "params": [
              {
                "name": "folderId",
                "value": "",
                "type": "path",
                "description": "The folder identifier to delete"
              },
              {
                "name": "recursive",
                "value": "",
                "type": "query",
                "description": "Deletes all child folders and archives their workspaces. Defaults to false."
              }
            ]
          },
          "docs": "Deletes a folder. Optionally deletes all child folders and archives their files recursively."
        }
      ]
    }
  ],
  "bundled": true
}
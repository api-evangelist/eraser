        {
          "id": "0a6829ff-e0a5-43ae-8ce9-c5cbd583b3dc",
          "name": "Query audit logs",
          "request": {
            "name": "Query audit logs",
            "description": {
              "content": "Query audit events with cursor-based pagination. Requires an audit API key (not the team bearer token). Supports filtering by time range, event type, and user.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "audit-logs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "startTime",
                  "value": "<dateTime>",
                  "description": "Start of the time range (inclusive). RFC3339/ISO 8601 timestamp."
                },
                {
                  "disabled": false,
                  "key": "endTime",
                  "value": "<dateTime>",
                  "description": "End of the time range (exclusive). RFC3339/ISO 8601 timestamp."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Opaque cursor string for pagination."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Maximum events per request (1-1000). Defaults to 100."
                },
                {
                  "disabled": false,
                  "key": "eventType",
                  "value": "<string>",
                  "description": "Filter by action type."
                },
                {
                  "disabled": false,
                  "key": "userId",
                  "value": "<string>",
                  "description": "Filter events by the ID of the user who performed the action."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "ecs",
                  "description": "Output format. Defaults to ecs."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Authorization"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },

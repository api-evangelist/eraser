          "id": "b811b8e8-c627-4ebe-8182-ff24e9b71705",
          "name": "Retrieve a previous AI diagram request",
          "request": {
            "name": "Retrieve a previous AI diagram request",
            "description": {
              "content": "Retrieves the inputs and outputs of a previously generated AI diagram request by its request ID. Optionally returns the PNG image directly as a file stream.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "ai-requests",
                ":requestId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "returnFile",
                  "value": "<string>",
                  "description": "When true, returns the PNG image file directly instead of JSON"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "requestId",
                  "description": "(Required) ID of the AI request to retrieve (from /api/render/prompt response)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
